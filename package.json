{
  "name": "microverse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck && tsc --project e2e/tsconfig.json",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test && pnpm test:deployment",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:deployment": "node --test deployment/scripts/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1",
    "@types/node": "catalog:"
  }
}
