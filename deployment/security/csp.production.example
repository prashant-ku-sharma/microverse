# HTTP response-header template. Replace .example origins to match the controlled NUCLEUS policy.
# Begin in report-only mode, inspect violations, then enforce as Content-Security-Policy.
Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://parasite.microverse.example https://symbiont.microverse.example https://commensal.microverse.example https://mutant.microverse.example; connect-src 'self' https://parasite.microverse.example https://symbiont.microverse.example https://commensal.microverse.example https://mutant.microverse.example; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://parasite.microverse.example https://symbiont.microverse.example https://commensal.microverse.example https://mutant.microverse.example; font-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
