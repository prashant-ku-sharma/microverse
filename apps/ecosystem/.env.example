# Optional public branding override. Never put secrets in VITE_* variables.
VITE_APP_LABEL=MICROVERSE
# Build-time development remote address; this is not a runtime registry.
VITE_PARASITE_REMOTE_ENTRY=http://127.0.0.1:5001/remoteEntry.js

# Build/dev-start override; runtime registry remains deferred.
VITE_SYMBIONT_REMOTE_ENTRY=http://127.0.0.1:5002/remoteEntry.js
VITE_COMMENSAL_REMOTE_ENTRY=http://127.0.0.1:5003/remoteEntry.js
VITE_MUTANT_REMOTE_ENTRY=http://127.0.0.1:5004/remoteEntry.js
